PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret

# Set your PostgreSQL connection string in your local .env file.
# Local example:
# DATABASE_URL=postgresql://username:password@localhost:5432/database_name
# Hosted example:
# DATABASE_URL=postgresql://username:password@host.example.com:5432/database_name
# If your password contains special characters (for example: @, /, :),
# URL-encode the password before placing it in the connection string.
DATABASE_URL=postgresql://username:password@host.example.com:5432/database_name
