PORT=3000
NODE_ENV=development

# Set your Postgres connection string here. Example formats:
#  DATABASE_URL=postgresql://username:password@localhost:5432/database_name
#  DATABASE_URL=postgres://username:password@db.example.com:5432/database_name
# If your password contains special characters (for example: @, /, :),
# URL-encode the password before placing it here.
DATABASE_URL=postgresql://username:password@host:5432/database_name
