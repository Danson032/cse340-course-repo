<%- include("header", { pageTitle: pageTitle }) %>

<main class="pageContent">
  <section class="formPage" aria-labelledby="assignCategoriesHeading">
    <p class="eyebrow">Service Project</p>
    <h1 id="assignCategoriesHeading">Assign Categories</h1>
    <p>Choose the categories that apply to <strong><%= project.project_name %></strong>.</p>

    <% if (errors && errors.length) { %>
      <div class="formErrors" role="alert">
        <h2>Please correct the following:</h2>
        <ul><% errors.forEach((error) => { %><li><%= error %></li><% }) %></ul>
      </div>
    <% } %>

    <form action="/assign-categories/<%= project.project_id %>" method="POST" class="dataForm">
      <fieldset class="formFieldset">
        <legend>Project Categories</legend>
        <% categories.forEach((category) => { %>
          <label class="checkOption">
            <input
              type="checkbox"
              name="category_ids"
              value="<%= category.category_id %>"
              <%= selectedCategoryIds.includes(category.category_id) ? "checked" : "" %>
            />
            <%= category.category_name %>
          </label>
        <% }) %>
      </fieldset>

      <div class="formActions">
        <button class="button buttonPrimary" type="submit">Save Categories</button>
        <a class="button buttonSecondary" href="/project/<%= project.project_id %>">Cancel</a>
      </div>
    </form>
  </section>
</main>

<%- include("footer") %>
