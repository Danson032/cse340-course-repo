<%- include("header", { pageTitle: pageTitle }) %>

<main class="pageContent">
  <section class="formPage" aria-labelledby="editCategoryHeading">
    <p class="eyebrow">Categories</p>
    <h1 id="editCategoryHeading">Edit Category</h1>
    <p>Update the name of this service category.</p>

    <% if (errors && errors.length > 0) { %>
      <div class="formErrors" role="alert" aria-labelledby="categoryErrorsHeading">
        <h2 id="categoryErrorsHeading">Please correct the following:</h2>
        <ul>
          <% errors.forEach((error) => { %>
            <li><%= error %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <form
      action="/edit-category/<%= category.category_id %>"
      method="POST"
      class="dataForm"
    >
      <div class="formField">
        <label for="category_name">Category Name</label>
        <input
          type="text"
          id="category_name"
          name="category_name"
          value="<%= category.category_name %>"
          required
          maxlength="100"
          autocomplete="off"
        />
        <p class="fieldHelp">Required. Maximum 100 characters.</p>
      </div>

      <div class="formActions">
        <button class="button buttonPrimary" type="submit">Save Changes</button>
        <a class="button buttonSecondary" href="/category/<%= category.category_id %>">Cancel</a>
      </div>
    </form>
  </section>
</main>

<%- include("footer") %>
