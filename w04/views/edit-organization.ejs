<%- include("header", { pageTitle: pageTitle }) %>

<main class="pageContent">
  <section class="formPage" aria-labelledby="editOrganizationHeading">
    <p class="eyebrow">Organizations</p>
    <h1 id="editOrganizationHeading">Edit Organization</h1>
    <p>Update the organization information.</p>

    <% if (errors && errors.length) { %>
      <div class="formErrors" role="alert">
        <h2>Please correct the following:</h2>
        <ul>
          <% errors.forEach((error) => { %><li><%= error %></li><% }) %>
        </ul>
      </div>
    <% } %>

    <form action="/edit-organization/<%= organization.organization_id %>" method="POST" class="dataForm">
      <div class="formField">
        <label for="organization_name">Organization Name</label>
        <input id="organization_name" name="organization_name" type="text"
          value="<%= organization.organization_name %>" required maxlength="255" />
      </div>

      <div class="formField">
        <label for="organization_description">Description</label>
        <textarea id="organization_description" name="organization_description"
          required maxlength="5000" rows="6"><%= organization.organization_description %></textarea>
      </div>

      <div class="formField">
        <label for="website">Website</label>
        <input id="website" name="website" type="url"
          value="<%= organization.website %>" required maxlength="255" />
      </div>

      <div class="formField">
        <label for="email">Email</label>
        <input id="email" name="email" type="email"
          value="<%= organization.email %>" required maxlength="255" />
      </div>

      <div class="formActions">
        <button class="button buttonPrimary" type="submit">Save Changes</button>
        <a class="button buttonSecondary" href="/organization/<%= organization.organization_id %>">Cancel</a>
      </div>
    </form>
  </section>
</main>

<%- include("footer") %>
