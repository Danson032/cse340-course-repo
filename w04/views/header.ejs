<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Connect volunteers with meaningful community service opportunities." />
  <title>
    <%= typeof title !=="undefined" ? title : (typeof pageTitle !=="undefined" ? pageTitle : "Service Network" ) %>
  </title>
  <link rel="stylesheet" href="/css/styles.css" />
</head>

<body>
  <header class="siteHeader">
    <div class="headerInner">
      <a class="brand" href="/" aria-label="CSE 340 Service Network home">
        <span class="brandMark">CSE</span>
        <span class="brandText">Service Network</span>
      </a>

      <nav aria-label="Main navigation">
        <ul class="navList">
          <li><a href="/">Home</a></li>
          <li><a href="/organizations">Organizations</a></li>
          <li><a href="/projects">Projects</a></li>
          <li><a href="/categories">Categories</a></li>

          <% if (currentUser) { %>
            <li><a href="/dashboard">Dashboard</a></li>

            <% if (currentUser.role_name==="admin" ) { %>
              <li><a href="/users">Users</a></li>
              <% } %>

                <li>
                  <form action="/logout" method="POST">
                    <button type="submit">Log Out</button>
                  </form>
                </li>
                <% } else { %>
                  <li><a href="/login">Log In</a></li>
                  <li><a href="/register">Register</a></li>
                  <% } %>
        </ul>
      </nav>
    </div>
  </header>

  <% if (typeof flash !=="undefined" && flash) { %>
    <div class="flashMessage" role="status">
      <%= flash %>
    </div>
    <% } %>