<%- include("header") %>

    <main class="container">
        <h1>Create an Account</h1>

        <% if (error) { %>
            <p class="error" role="alert">
                <%= error %>
            </p>
            <% } %>

                <form action="/register" method="POST">
                    <div>
                        <label for="name">Full Name</label>
                        <input id="name" name="name" type="text" maxlength="100" autocomplete="name"
                            value="<%= formData.name || '' %>" required>
                    </div>

                    <div>
                        <label for="email">Email Address</label>
                        <input id="email" name="email" type="email" maxlength="255" autocomplete="email"
                            value="<%= formData.email || '' %>" required>
                    </div>

                    <div>
                        <label for="password">Password</label>
                        <input id="password" name="password" type="password" minlength="6" autocomplete="new-password"
                            required>
                    </div>

                    <div>
                        <label for="confirmPassword">Confirm Password</label>
                        <input id="confirmPassword" name="confirmPassword" type="password" minlength="6"
                            autocomplete="new-password" required>
                    </div>

                    <button type="submit">Register</button>
                </form>

                <p>Already have an account? <a href="/login">Log in</a>.</p>
    </main>

    <%- include("footer") %>